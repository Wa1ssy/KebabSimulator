@model Kebab_Simulator.Models.ViewModels.KebabViewModel
@{
    ViewData["Title"] = "Cooking " + Model.Name;
    int cookTime = ViewBag.CookTime;
    int grillLevel = ViewBag.GrillLevel;
}

<div class="container text-center mt-5">
    <h2 class="mb-3">🍢 Cooking: <span class="text-primary">@Model.Name</span></h2>
    <p class="text-muted">@Model.Description</p>
    <p><strong>Ingredients:</strong> @Model.Ingredients</p>
    <p><strong>🔥 Grill Level:</strong> @grillLevel</p>

    <div id="timer" class="display-6 my-3">Choose a game to start</div>

    <!-- 🎮 Game selection screen -->
    <div id="select-screen" class="p-4 rounded shadow-lg" style="max-width:680px;margin:0 auto;background:#222;">
        <h4 class="text-warning mb-3">Choose a mini-game to cook faster</h4>
        <div class="d-grid gap-3">
            <button class="btn btn-outline-warning btn-lg" data-game="clicker">🔥 Clicker</button>
            <button class="btn btn-outline-info btn-lg" data-game="reaction">⚡ Reaction</button>
            <button class="btn btn-outline-success btn-lg" data-game="math">🧮 Math</button>
        </div>
        <small class="text-muted d-block mt-3">Time and bonus are shown inside the game.</small>
    </div>

    <!-- 🔥 Mini-game mount point -->
    <div id="minigame-area-wrapper" class="d-none" data-cooktime="@cookTime"></div>

    <form asp-controller="Kebab" asp-action="Sell" method="post" class="mt-3">
        <input type="hidden" name="recipeId" value="@Model.ID" />
        <button id="sellBtn" type="submit" class="btn btn-success btn-lg" disabled>
            Sell for $@Model.Price
        </button>
    </form>

    <div class="mt-3">
        <a asp-controller="Marketplace" asp-action="Index" class="btn btn-secondary">Back to Marketplace</a>
    </div>
</div>

@section Scripts {
    <!-- Load mini-game scripts first -->
    <script src="~/js/minigame.js"></script>   <!-- Clicker -->
    <script src="~/js/reaction.js"></script>   <!-- Reaction -->
    <script src="~/js/math.js"></script>       <!-- Math -->
    <!-- Then the manager that injects the chosen game -->
    <script src="~/js/store-manager.js"></script>
}
        