@model Kebab_Simulator.Models.KebabModels.KebabDetailsViewModel

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-capitalize">@Model.KebabName</h2>
            <p class="text-muted mb-4">I need to make some quick money from kebab.</p>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">ID:</div>
                <div class="col-sm-9">@Model.ID</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">Kebab Name:</div>
                <div class="col-sm-9">@Model.KebabName</div>
            </div>

            @if (Model.Image != null && Model.Image.Any())
            {
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold">Images:</div>
                    <div class="col-sm-9 d-flex flex-wrap gap-2" id="imagediv">
                        @foreach (var image in Model.Image)
                        {
                            <partial name="_Images" model="image" />
                        }
                    </div>
                </div>
            }

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">Kebab XP:</div>
                <div class="col-sm-9">@Model.KebabXP</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">XP to Next Level:</div>
                <div class="col-sm-9">@Model.KebabXPNextLevel</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">Level:</div>
                <div class="col-sm-9">@Model.KebabLevel</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">Bank Account:</div>
                <div class="col-sm-9">@Model.KebabBankAccount €</div>
            </div>
            <a asp-action="Index" asp-controller="Kebab" class="btn btn-primary">← Go Back</a>
        </div>
    </div>
</div>
