@model IEnumerable<Kebab_Simulator.Models.KebabModels.KebabIndexViewModel>

<div class="kebab-header text-center mb-4">
    <h1>Kebab Simulator</h1>
    <p>Manage Your Kebab Empire</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success text-center fade show" role="alert" id="successMessage">
        @TempData["Message"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center fade show" role="alert">
        @TempData["Error"]
    </div>
}

<div class="container">
    <div class="d-flex justify-content-between mb-4">
        <div>
            <a asp-action="Index" asp-controller="Marketplace" class="btn btn-success me-2">
                <i class="fas fa-store"></i> Marketplace
            </a>

            <a asp-action="Upgrades" asp-controller="Marketplace" class="btn btn-warning">
                <i class="fas fa-tools"></i> Upgrades
            </a>
        </div>
    </div>

    <div class="kebab-card">
        <table class="table table-hover">
            <thead class="thead-dark">
                <tr>
                    <th class="text-center">Name</th>
                    <th class="text-center">Level</th>
                    <th class="text-center">Bank</th>
                    <th class="text-center">Actions:</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Kebab in Model)
                {
                    <tr>
                        <td class="text-center">@Kebab.KebabName</td>
                        <td class="text-center">@Kebab.KebabLevel</td>
                        <td class="text-center" id="bank-@Kebab.ID">@Kebab.KebabBankAccount €</td>
                        <td style="text-align: center;">
                            <a asp-action="Details" asp-route-id="@Kebab.ID" class="btn btn-sm btn-info">
                                <i class="fas fa-info-circle"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const msg = document.getElementById('successMessage');
        if (msg) {
            setTimeout(() => {
                msg.classList.remove('show');
                msg.classList.add('fade');
            }, 3000);
        }
    </script>
}
