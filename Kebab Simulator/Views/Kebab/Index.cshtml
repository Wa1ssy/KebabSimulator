@model IEnumerable<Kebab_Simulator.Models.KebabModels.KebabIndexViewModel>

<div class="kebab-header">
    <h1>Kebab Simulator</h1>
    <p>Manage Your Kebab Empire</p>
</div>

<div class="container">
    <div class="d-flex justify-content-between mb-4">
        <a asp-action="Add" asp-controller="Kebab" class="btn btn-primary">
            <i class="fas fa-plus"></i> Make Kebab
        </a>
        <a asp-action="Create" asp-controller="Kebab" class="btn btn-secondary">
            <i class="fas fa-user-plus"></i> New Character
        </a>
    </div>

    <div class="kebab-card">
        <table class="table table-hover">
            <thead class="thead-dark">
                <tr>
                    <th style="text-align: center;">#</th>
                    <th style="text-align: center;">Name</th>
                    <th style="text-align: center;">Level</th>
                    <th style="text-align: center;">Bank</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1;
                }
                @foreach (var Kebab in Model)
                {
                    <tr>
                        <td style="text-align: center;">@rowNumber</td>
                        <td style="text-align: center;">@Kebab.KebabName</td>
                        <td style="text-align: center;">@Kebab.KebabLevel</td>
                        <td style="text-align: center;">@Kebab.KebabBankAccount €</td>
                        <td style="text-align: center;">
                            <a asp-action="Details" asp-route-id="@Kebab.ID" class="btn btn-sm btn-info">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a asp-action="Update" asp-route-id="@Kebab.ID" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@Kebab.ID" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
</div>