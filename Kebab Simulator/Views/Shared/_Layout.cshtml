@using Microsoft.AspNetCore.Identity
@inject SignInManager<Kebab_Simulator.Core.Domain.ApplicationUser> signInManager;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kebab_Simulator</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3">
            <div class="container-fluid px-3">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Kebab_Simulator</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Kebab" asp-action="Index">Kebab</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-2">
                            <button id="theme-toggle" class="btn btn-sm" title="Lülita teemat">Dark/Light</button>
                        </li>

                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item ms-3">
                                <form method="post" asp-controller="Accounts" asp-action="Logout">
                                    <button type="submit" class="nav-link btn btn-link py-0 text-light" style="width:auto;">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="nav-link text-light" asp-controller="Accounts" asp-action="Register">Register</a>
                            </li>
                            <li>
                                <a class="nav-link text-light" asp-controller="Accounts" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (signInManager.IsSignedIn(User))
    {
        <script>
            let playerMoney = 0;
            async function fetchPlayerMoney() {
                try {
                    const res = await fetch('/Kebab/GetBankBalance');
                    const data = await res.json();
                    playerMoney = data.bank;
                    const elem = document.getElementById('bank-amount');
                    if (elem) elem.textContent = playerMoney;
                } catch (e) {
                    console.error("Error fetching balance", e);
                }
            }

            async function startAssistantIncome() {
                while (true) {
                    const res = await fetch('/Kebab/CollectPassiveIncome', { method: 'POST' });
                    const data = await res.json();
                    if (data.earned > 0) {
                        playerMoney += data.earned;
                        const elem = document.getElementById('bank-amount');
                        if (elem) elem.textContent = playerMoney;
                        const msg = document.createElement('div');
                        msg.textContent = `+ $${data.earned} (Assistant)`;
                        msg.className = "assistant-income";
                        document.body.appendChild(msg);
                        setTimeout(() => msg.remove(), 2000);
                    }
                    await new Promise(r => setTimeout(r, (data.interval || 30) * 1000));
                }
            }

            document.addEventListener("DOMContentLoaded", async () => {
                await fetchPlayerMoney();
                startAssistantIncome();
            });
        </script>
    }
</body>
</html>
