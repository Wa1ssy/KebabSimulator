@using Microsoft.AspNetCore.Identity
@inject SignInManager<Kebab_Simulator.Core.Domain.ApplicationUser> signInManager;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kebab_Simulator</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div id="health-popup-overlay"></div>
    <div id="health-popup">
        <p id="health-popup-text">Health inspection</p>
        <button id="health-popup-close">OK</button>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3">
            <div class="container-fluid px-3">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Kebab_Simulator</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Kebab" asp-action="Index">Kebab</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item ms-3">
                                <form method="post" asp-controller="Accounts" asp-action="Logout">
                                    <button type="submit" class="nav-link btn btn-link py-0 text-light" style="width:auto;">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Accounts" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Accounts" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (signInManager.IsSignedIn(User))
    {
        <img id="cockroach" src="~/images/cockroach_alive.png"
             style="display:none; position:fixed; width:50px; height:50px; cursor:pointer; z-index:9999;">

        <script>
            (function () {

                window.cockroachOnScreen = false;

                const cockroach = document.getElementById("cockroach");
                if (!cockroach) return;

                let isAlive = true;

                function showCockroach(x, y) {
                    cockroach.style.left = x + 'px';
                    cockroach.style.top = y + 'px';
                    cockroach.src = '/images/cockroach_alive.png';
                    cockroach.style.display = 'block';
                    cockroach.style.opacity = 1;

                    window.cockroachOnScreen = true;

                    localStorage.setItem('cockroachKilled', 'false');
                    moveRandomly();
                }

                function moveRandomly() {
                    if (cockroach.style.display !== 'block') return;
                    const newX = Math.random() * (window.innerWidth - 100);
                    const newY = Math.random() * (window.innerHeight - 100);
                    const angle = (Math.random() * 60) - 30;
                    cockroach.style.transform = 'rotate(' + angle + 'deg)';
                    cockroach.style.left = newX + 'px';
                    cockroach.style.top = newY + 'px';
                    localStorage.setItem('cockroachX', newX);
                    localStorage.setItem('cockroachY', newY);
                    setTimeout(moveRandomly, 500 + Math.random() * 1000);
                }

                document.addEventListener('mousemove', (e) => {
                    if (!isAlive || cockroach.style.display !== 'block') return;
                    const rect = cockroach.getBoundingClientRect();
                    const dx = e.clientX - (rect.left + rect.width / 2);
                    const dy = e.clientY - (rect.top + rect.height / 2);
                    const distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < 100) {
                        let evadeX = rect.left - dx / distance * 50;
                        let evadeY = rect.top - dy / distance * 50;
                        evadeX = Math.max(0, Math.min(evadeX, window.innerWidth - rect.width));
                        evadeY = Math.max(0, Math.min(evadeY, window.innerHeight - rect.height));
                        cockroach.style.left = evadeX + 'px';
                        cockroach.style.top = evadeY + 'px';
                    }
                });

                function spawnCockroach() {
                    if (cockroach.style.display === 'block') return;
                    const x = Math.random() * (window.innerWidth - 100);
                    const y = Math.random() * (window.innerHeight - 100);
                    showCockroach(x, y);
                }

                function scheduleNextSpawn() {
                    const delay = 45000 + Math.random() * 55000;
                    setTimeout(() => {
                        const killed = localStorage.getItem('cockroachKilled');
                        if (killed === 'true') {
                            const respawnDelay = 30000 + Math.random() * 30000;
                            setTimeout(spawnCockroach, respawnDelay);
                        } else if (Math.random() < 0.3) {
                            spawnCockroach();
                        }
                        scheduleNextSpawn();
                    }, delay);
                }

                const killed = localStorage.getItem('cockroachKilled');
                const posX = parseFloat(localStorage.getItem('cockroachX'));
                const posY = parseFloat(localStorage.getItem('cockroachY'));
                if (killed !== 'true' && !isNaN(posX) && !isNaN(posY)) {
                    showCockroach(posX, posY);
                }

                cockroach.addEventListener('click', async () => {
                    if (!isAlive) return;
                    isAlive = false;

                    cockroach.src = '/images/cockroach_dead.png';
                    cockroach.style.transition = 'opacity 1s ease';
                    cockroach.style.opacity = 0;
                    localStorage.setItem('cockroachKilled', 'true');

                    try {
                        const res = await fetch('/Kebab/KillCockroach', { method: 'POST' });
                        const data = await res.json();

                        const msg = document.createElement('div');
                        msg.textContent = `+${data.xpGained} XP for killing cockroach`;
                        msg.className = "assistant-income";
                        document.body.appendChild(msg);
                        setTimeout(() => msg.remove(), 3000);

                        console.log(`Gained ${data.xpGained} XP, total XP: ${data.newXP}`);
                    } catch (e) {
                        console.error("Failed to gain XP", e);
                    }

                    setTimeout(() => {
                        cockroach.style.display = 'none';

                        window.cockroachOnScreen = false;

                        cockroach.style.transition = 'left 0.8s linear, top 0.8s linear, transform 0.5s linear, opacity 1s ease';
                        cockroach.style.opacity = 1;
                        isAlive = true;
                    }, 3000);
                });

                scheduleNextSpawn();
            })();
        </script>
        <script>
            let playerMoney = 0;

            async function fetchPlayerMoney() {
                try {
                    const res = await fetch('/Kebab/GetBankBalance');
                    const data = await res.json();
                    playerMoney = data.bank;
                    const elem = document.getElementById('bank-amount');
                    if (elem) elem.textContent = playerMoney;
                } catch (e) {
                    console.error("Error fetching balance", e);
                }
            }

            async function startAssistantIncome() {
                while (true) {
                    const res = await fetch('/Kebab/CollectPassiveIncome', { method: 'POST' });
                    const data = await res.json();
                    if (data.earned > 0) {
                        playerMoney += data.earned;
                        const elem = document.getElementById('bank-amount');
                        if (elem) elem.textContent = playerMoney;
                        const msg = document.createElement('div');
                        msg.textContent = `+ $${data.earned} (Assistant)`;
                        msg.className = "assistant-income";
                        document.body.appendChild(msg);
                        setTimeout(() => msg.remove(), 2000);
                    }
                    await new Promise(r => setTimeout(r, (data.interval || 30) * 1000));
                }
            }

            document.addEventListener("DOMContentLoaded", async () => {
                await fetchPlayerMoney();
                startAssistantIncome();
            });
        </script>
    }

    <script>
        (function () {
            var showHealth = @((ViewBag.ShowHealthInspection ?? false).ToString().ToLower());

            if (!showHealth) {
                return;
            }

            var overlay = document.getElementById("health-popup-overlay");
            var popup = document.getElementById("health-popup");
            var closeBtn = document.getElementById("health-popup-close");
            var textEl = document.getElementById("health-popup-text");

            var cockroachPresent = (window.cockroachOnScreen === true);

            if (cockroachPresent) {
                textEl.innerText = "Tervisekontroll! Kahjur avastatud! -100$";
                changeMoney(-100);
            } else {
                textEl.innerText = "Health inspection successful!";
            }

            overlay.style.display = "block";
            popup.style.display = "block";

            closeBtn.onclick = function () {
                overlay.style.display = "none";
                popup.style.display = "none";
            };
        })();

        function changeMoney(amount) {
            var elem = document.getElementById('bank-amount');
            if (!elem) return;

            var value = parseInt(elem.textContent);
            if (isNaN(value)) value = 0;

            elem.textContent = value + amount;
        }
    </script>

</body>
</html>
