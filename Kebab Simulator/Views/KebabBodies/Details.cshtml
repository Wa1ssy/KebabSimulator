@model Kebab_Simulator.Models.KebabBodies.CountryDetailsViewModel

@{
    ViewData["Title"] = "Country Details";
}

<h2>@Model.Name</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.CountryType</dd>

        <dt class="col-sm-2">Created</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    <partial name="_ImagesIndex" model="Model.Image" />
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>