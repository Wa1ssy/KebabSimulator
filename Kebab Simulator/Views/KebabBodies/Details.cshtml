@model Kebab_Simulator.Models.KebabBodies.CountryDetailsViewModel

@{
    ViewData["Title"] = "Country Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-capitalize">@Model.Name</h2>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">Type:</div>
                <div class="col-sm-9">@Model.CountryType</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 fw-bold">Created:</div>
                <div class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
            </div>

            @if (Model.Image != null && Model.Image.Any())
            {
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold">Images:</div>
                    <div class="col-sm-9 d-flex flex-wrap gap-2">
                        <partial name="_ImagesIndex" model="Model.Image" />
                    </div>
                </div>
            }

            <a asp-action="Index" asp-controller="KebabBodies" class="btn btn-primary">← Go Back</a>
        </div>
    </div>
</div>
