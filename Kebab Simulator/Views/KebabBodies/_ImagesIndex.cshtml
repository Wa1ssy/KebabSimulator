@model IEnumerable<Kebab_Simulator.Models.KebabBodies.CountryImageViewModel>

@if (Model.Any())
{
    <h4>Images</h4>
    <div class="row">
        @foreach (var image in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card">
                    <img src="@image.Image" class="card-img-top" alt="@image.ImageTitle">
                    <div class="card-body">
                        <form asp-action="RemoveImage" method="post">
                            <input type="hidden" name="ImageID" value="@image.ImageID" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}