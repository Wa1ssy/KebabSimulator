@model IEnumerable<Kebab_Simulator.Models.KebabBodies.CountryIndexViewModel>

<div class="kebab-header">
    <h1>Countries Management</h1>
    <p>Expand Your Kebab Kingdom</p>
</div>

<div class="container">
    <div class="kebab-card">
        <div class="d-flex justify-content-between mb-3">
            <h2>Countries List</h2>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-globe-europe"></i> New Country
            </a>
        </div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.CountryType</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Update" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>