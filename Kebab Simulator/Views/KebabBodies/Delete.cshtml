@model Kebab_Simulator.Models.KebabBodies.CountryDeleteViewModel

@{
    ViewData["Title"] = "Delete Country";
}

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.CountryType</dd>
    </dl>

    <partial name="_ImagesIndex" model="Model.Image" />

    <form asp-action="DeleteConfirmation">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>