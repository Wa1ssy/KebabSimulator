@model Kebab_Simulator.Models.KebabBodies.CountryCreateViewModel

@{
    ViewData["Title"] = "Create Country";
}

<h2>Create New Country</h2>

<form asp-action="Create" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CountryType" class="control-label"></label>
        <select asp-for="CountryType" class="form-control"
                asp-items="Html.GetEnumSelectList<Kebab_Simulator.Core.Domain.CountryType>()"></select>
        <span asp-validation-for="CountryType" class="text-danger"></span>
    </div>

    <partial name="_Images" model="Model" />

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-success" />
    </div>
</form>