@model Kebab_Simulator.Models.ViewModels.PlayerViewModel

<h2>Kebab Simulator</h2>

<p><strong>Player:</strong> @Model.Username</p>
<p><strong>Level:</strong> @Model.Level</p>
<p><strong>XP:</strong> @Model.CurrentXP / @Model.XPToNextLevel</p>
<p><strong>Balance:</strong> @Model.Balance Tenge</p>
<p><strong>Total Kebabs Sold:</strong> @Model.TotalKebabsSold</p>

<form asp-action="CookKebab" method="post">
    <button type="submit" class="btn btn-success">🍢 Cook Kebab</button>
</form>

<hr />

<h3>Achievements 🏆</h3>
<ul>
    @foreach (var a in Model.Achievements)
    {
        <li>
            <strong>@a.Title</strong> – @a.Description
            @if (a.IsUnlocked)
            {
                <span style="color:green;">✅ Unlocked (@a.UnlockedAt?.ToString("g"))</span>
            }
            else
            {
                <span style="color:gray;">🔒 Locked</span>
            }
        </li>
    }
</ul>

<a asp-action="Marketplace">Go to Marketplace 🛒</a>
