@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Home Page";
}



    <div class="kebab-header">
        <h1 class="display-4">Welcome to Kebab Simulator</h1>
        <p class="lead">Build your kebab empire across the World!</p>
    </div>

    @if (User.Identity.IsAuthenticated)
    {

    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="kebab-card h-100">
                    <h3>Start Cooking</h3>
                    <p>Choose your chef and start earning</p>
                    <a asp-controller="Kebab" asp-action="Create" class="btn btn-primary">Get Started</a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="kebab-card h-100">
                    <h3>Expand Territories</h3>
                    <p>Manage countries and grow your business</p>
                    <a asp-controller="KebabBodies" asp-action="Index" class="btn btn-secondary">Manage Countries</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>Palun logi sisse, et näha sisu.</p>
    <img src="unnamed.jpg" alt="Welcome image" />
}
