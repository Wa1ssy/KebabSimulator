@model Kebab_Simulator.Models.Accounts.ForgotPasswordViewModel

<div class="page-center">
    <div class="">
        <h2 class="text-center">Forgor password?</h2>
        <hr />
        <p class="text-center text-dark">
            Type your email here, <br />
            confirmation email will appear so you can recover your password
        </p>

        <form method="post" class="p-4 shadow rounded bg-white">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control border border-dark" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>
