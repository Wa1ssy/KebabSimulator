@{
    ViewBag.Title = "Verify your email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 text-center">
    <h1 class="mb-3 text-success">🎉 Registration successful!</h1>
    <p class="lead">
        We’ve sent a confirmation link to your email address.<br />
        Please check your inbox (and spam folder) and click the link to verify your email before logging in.
    </p>

    <div class="mt-4">
        <a href="https://mail.google.com/" target="_blank" class="btn btn-primary me-2">
            Open Gmail
        </a>
        <a asp-action="Login" asp-controller="Accounts" class="btn btn-outline-secondary">
            Go to Login
        </a>
    </div>

    <div class="mt-5">
        <i class="fas fa-burger-soda fa-3x text-warning"></i>
        <p class="mt-2">Your kebab adventure awaits! 🍢</p>
    </div>
</div>
