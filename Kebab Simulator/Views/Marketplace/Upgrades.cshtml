@model IEnumerable<Kebab_Simulator.Models.ViewModels.UpgradeViewModel>
@{
    ViewData["Title"] = "Upgrades";
    var playerMoney = ViewBag.PlayerMoney;
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">⚙️ Player Upgrades</h1>
    <h5 class="text-center text-muted mb-3">Your Balance: <strong>$@playerMoney</strong></h5>

    <!-- Messages -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <div class="row mt-4">
        @foreach (var up in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0 h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@up.Name</h5>
                        <p>@up.Description</p>
                        <p><strong>Cost:</strong> $@up.UpgradeCost</p>
                        <p><strong>Level:</strong> @up.CurrentLevel / @up.MaxLevel</p>

                        <div class="mt-auto">
                            @if (!up.IsMaxedOut)
                            {
                                <form asp-controller="Kebab" asp-action="BuyUpgrade" method="post">
                                    <input type="hidden" name="upgradeName" value="@up.Name" />
                                    <button type="submit" class="btn btn-warning w-100 fw-bold">
                                        Buy Upgrade 💸
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 fw-bold" disabled>
                                    Maxed Out 🏆
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Marketplace" class="btn btn-outline-primary">
            ← Back to Marketplace
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Subtle fade out for success messages
        const successMsg = document.querySelector('.alert-success');
        if (successMsg) {
            setTimeout(() => successMsg.style.display = 'none', 3000);
        }
    </script>
}
